+        converted = true;
+    }
+    if (converted) {
+        for (size_t offset = 0; offset < length; ) {
+            uint8_t *ie = ies + offset;
+            size_t size = size_t(ie[1]) + 2;
+            if (offset + size > length)
+                break;
+            if (ie[0] == 244) {
+                memmove(ie, ie + size, length - offset - size);
+                length -= size;
+                continue;
+            }
+            offset += size;
+        }
     }
     return length;
 }
