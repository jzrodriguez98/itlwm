     if (!validIEs(ies, length))
         return length;
+    bool converted = false;
     for (size_t offset = 0; offset < length; ) {
         uint8_t *ie = ies + offset;
         size_t size = size_t(ie[1]) + 2;
+        if (offset + size > length)
+            break;
         if (ie[0] != 48 || size < 10 || read16(ie + 2) != 1) {
